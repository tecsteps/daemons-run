{
  "name": "control-plane",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:ui && concurrently -k \"vite build --watch --mode development\" \"wrangler dev --local\"",
    "build": "vite build",
    "build:ui": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "sync-installer": "cp ../installer/install.sh ../installer/cloud-init.yaml.tmpl src/worker/generated/",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.3",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@playwright/test": "^1.60.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "description": "daemons.run control plane: your servers, terminals and apps, in your own Cloudflare account.",
  "cloudflare": {
    "label": "daemons.run control plane",
    "products": [
      "Workers",
      "D1",
      "Durable Objects"
    ],
    "categories": [
      "developer-tools"
    ],
    "bindings": {
      "SETUP_CODE": {
        "description": "Any phrase you will type **once**, when you register your first passkey on your new control plane. Changing it later lets you set up new passkeys and revokes all others."
      }
    }
  }
}
