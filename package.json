{
  "name": "daemons-run",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": ["control-plane", "apps-gateway"],
  "scripts": {
    "dev": "npm run dev -w control-plane",
    "build": "npm run build --workspaces --if-present",
