---
// Adapted from old daemons-run resources/views/components/public/header.blade.php
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import { GITHUB } from './site';
const nav = [
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/#yours', label: 'Your accounts' },
  { href: '/#apps', label: 'Apps' },
  { href: '/#cost', label: 'Cost' },
];
const navLink = 'rounded-md px-2.5 py-1.5 text-control font-medium whitespace-nowrap text-bone/80 hover:text-bone';
---
<header class="sticky top-0 z-40 border-b border-white/10 bg-ink-950/95">
  <div class="mx-auto flex h-[4.5rem] w-full min-w-0 max-w-6xl items-center justify-between gap-2 px-3 sm:px-4 md:px-6">
    <a href="/" class="inline-flex min-h-11 shrink-0 items-center gap-2.5 rounded-[6px] py-1 font-mono text-[17px] font-semibold tracking-[-0.06em] text-bone">
      <BrandMark size={36} />
      <span class="hidden min-[360px]:inline">daemons.run</span>
    </a>
    <div class="flex min-w-0 flex-1 items-center justify-end gap-1.5 md:gap-2">
      <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
        {nav.map((item) => <a href={item.href} class={navLink}>{item.label}</a>)}
      </nav>
      <a href={GITHUB} class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-md text-bone/80 hover:text-bone" aria-label="daemons.run on GitHub">
        <Icon name="github" size={22} />
      </a>
      <a href="/install" class="inline-flex h-11 min-h-11 shrink-0 items-center justify-center rounded-[6px] border-2 border-ink-900 bg-lime px-4 text-control font-semibold whitespace-nowrap text-ink-900 shadow-[0_3px_0_0_#11120F] hover:bg-lime/90 md:px-5">Install</a>
      <button type="button" class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-md border border-white/15 text-bone lg:hidden" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 5h12M3 9h12M3 13h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" /></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="hidden border-t border-white/10 bg-ink-950 px-4 pt-2 pb-4 lg:hidden" aria-label="Mobile">
    {nav.map((item) => <a href={item.href} class="flex min-h-12 items-center rounded-md px-3 text-section font-medium text-bone" data-menu-link>{item.label}</a>)}
    <a href={GITHUB} class="flex min-h-12 items-center rounded-md px-3 text-section font-medium text-bone">GitHub</a>
  </nav>
</header>
<script is:inline>
  (function () {
    var t = document.querySelector('[data-menu-toggle]');
    var m = document.getElementById('mobile-menu');
    function set(open) {
      m.classList.toggle('hidden', !open);
      t.setAttribute('aria-expanded', String(open));
      t.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    }
    t.addEventListener('click', function () { set(m.classList.contains('hidden')); });
    m.querySelectorAll('[data-menu-link]').forEach(function (a) { a.addEventListener('click', function () { set(false); }); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
  })();
</script>
