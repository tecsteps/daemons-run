  <path d="M9.2 10.2L16.4 16L9.2 21.8" stroke="#F5F1E8" stroke-width="2.4" stroke-linecap="square" />
  <path d="M34.8 10.2L27.6 16L34.8 21.8" stroke="#F5F1E8" stroke-width="2.4" stroke-linecap="square" />
</svg>
